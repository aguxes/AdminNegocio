-- Tablas de detalle
CREATE TABLE Generos (
    idSexo INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL
);

CREATE TABLE Paises (
    idPais INTEGER PRIMARY KEY,
    nombrePais TEXT NOT NULL
);

CREATE TABLE TipoUsers (
    tipo INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL
);

CREATE TABLE TiposClientes (
    tipo INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL
);

CREATE TABLE Roles (
    Rol INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL
);

CREATE TABLE MedidasProd (
    unidadMedida INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL
);

CREATE TABLE CategoriasProd (
    Categoria INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL
);

CREATE TABLE Monedas (
    idMoneda INTEGER PRIMARY KEY,
    descripcion TEXT NOT NULL,
    TasaCambio REAL NOT NULL
);

-- Tablas principales
CREATE TABLE Persona (
    DNI INTEGER PRIMARY KEY,
    nombre TEXT NOT NULL,
    apellido TEXT NOT NULL
);

CREATE TABLE Correos (
    idPersona INTEGER PRIMARY KEY,
    correo TEXT NOT NULL,
    FOREIGN KEY (idPersona) REFERENCES Persona(DNI)
);

CREATE TABLE Telefonos (
    idPersona INTEGER PRIMARY KEY,
    telefono INTEGER NOT NULL,
    FOREIGN KEY (idPersona) REFERENCES Persona(DNI)
);

CREATE TABLE Usuario (
    DNI INTEGER PRIMARY KEY,
    nombreUsuario TEXT NOT NULL,
    contrasenias TEXT NOT NULL,
    idTipo INTEGER NOT NULL,
    FOREIGN KEY (DNI) REFERENCES Persona(DNI),
    FOREIGN KEY (idTipo) REFERENCES TipoUsers(tipo)
);

CREATE TABLE Cliente (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    DNI INTEGER UNIQUE NOT NULL,
    idTipo INTEGER NOT NULL,
    fechAlta TEXT NOT NULL,
    cantCompras INTEGER NOT NULL,
    FOREIGN KEY (DNI) REFERENCES Persona(DNI),
    FOREIGN KEY (idTipo) REFERENCES TiposClientes(tipo)
);

CREATE TABLE Empleado (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    DNI INTEGER UNIQUE NOT NULL,
    idRol INTEGER NOT NULL,
    Sueldo REAL NOT NULL,
    Vacaciones INTEGER NOT NULL,
    Faltas INTEGER NOT NULL,
    FechaIngreso TEXT NOT NULL,
    FechaEgreso TEXT,
    Activo INTEGER NOT NULL,
    FOREIGN KEY (DNI) REFERENCES Persona(DNI),
    FOREIGN KEY (idRol) REFERENCES Roles(Rol)
);

CREATE TABLE Producto (
    idProducto INTEGER PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    costo REAL NOT NULL,
    stock INTEGER NOT NULL,
    idMedida INTEGER NOT NULL,
    idCategoria INTEGER NOT NULL,
    fechAlta TEXT NOT NULL,
    fechaBaja TEXT,
    FOREIGN KEY (idMedida) REFERENCES MedidasProd(unidadMedida),
    FOREIGN KEY (idCategoria) REFERENCES CategoriasProd(Categoria)
);

CREATE TABLE FormaDePagos (
    idPago INTEGER PRIMARY KEY,
    moneda INTEGER NOT NULL,
    descripcion TEXT NOT NULL,
    FOREIGN KEY (moneda) REFERENCES Monedas(idMoneda)
);

CREATE TABLE Venta (
    nFactura INTEGER PRIMARY KEY AUTOINCREMENT,
    idProd INTEGER,
    idE INTEGER,
    idC INTEGER,
    fecha TEXT NOT NULL,
    formaDePago INTEGER NOT NULL,
    cantidad INTEGER NOT NULL,
    subtotal REAL NOT NULL,
    total REAL NOT NULL,
    FOREIGN KEY (idProd) REFERENCES Producto(idProducto),
    FOREIGN KEY (idE) REFERENCES Empleado(ID),
    FOREIGN KEY (idC) REFERENCES Cliente(ID),
    FOREIGN KEY (formaDePago) REFERENCES FormaDePagos(idPago)
);
